# Apache .htaccess Configuration for offipro
# This file enables clean URLs (URL rewriting) for the website

# Enable Rewrite Engine
RewriteEngine On

# Dynamically determine the base
RewriteCond %{REQUEST_URI} ^(/shop/|/)
RewriteRule .? - [E=BASE:%1]

# 1. Redirection de www vers non-www (et force le HTTPS par la même occasion)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2. Redirection HTTP vers HTTPS (sauf en local)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Prevent access to sensitive files
<FilesMatch "^(config\.php|connec\.php|include\.php|lien\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirect .php to clean URLs (External Redirect)
RewriteCond %{REQUEST_URI} !/_admin_site/ [NC]
RewriteCond %{THE_REQUEST} \s/(?:shop/)?([^/.]+)\.php\?link=([^\s&]+)\s [NC]
RewriteRule ^([^/]+)\.php$ %{ENV:BASE}%2/? [R=301,L]

RewriteCond %{REQUEST_URI} !/_admin_site/ [NC]
RewriteCond %{THE_REQUEST} \s/(?:shop/)?([^/.]+)\.php\s [NC]
RewriteCond %1 !^index$ [NC]
RewriteRule ^([^/]+)\.php$ %{ENV:BASE}%1/ [R=301,L]

# ── PWA & SEO Dynamic Files ──────────────────────────────────────────────────
# Serve sitemap.xml dynamically from PHP
RewriteCond %{REQUEST_URI} ^(/shop/)?sitemap\.xml$ [NC]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# Serve manifest.webmanifest dynamically from PHP
RewriteCond %{REQUEST_URI} ^(/shop/)?manifest\.webmanifest$ [NC]
RewriteRule ^manifest\.webmanifest$ manifest.webmanifest.php [L,QSA]

# New Clean URLs (Priority)
RewriteRule ^produit/([^/]+)/?$ %{ENV:BASE}produit.php?link=$1 [L,QSA]
RewriteRule ^boutique/([^/]+)/?$ %{ENV:BASE}categorie.php?link=$1 [L,QSA]
RewriteRule ^boutique/?$ %{ENV:BASE}categorie.php [L,QSA]
RewriteRule ^panier/?$ %{ENV:BASE}cart.php [L,QSA]
RewriteRule ^applications/?$ %{ENV:BASE}applications.php [L,QSA]
RewriteRule ^configurateur-camera/?$ %{ENV:BASE}configurateur-camera.php [L,QSA]
RewriteRule ^ajax_configurateur/?$ %{ENV:BASE}ajax_configurateur.php [L,QSA]
RewriteRule ^contact/?$ %{ENV:BASE}contact.php [L,QSA]
RewriteRule ^inscription/?$ %{ENV:BASE}inscription.php [L,QSA]
RewriteRule ^connexion/?$ %{ENV:BASE}connexion.php [L,QSA]
RewriteRule ^mdp-oublie/?$ %{ENV:BASE}mdp-oublie.php [L,QSA]
RewriteRule ^compte/?$ %{ENV:BASE}compte.php [L,QSA]
RewriteRule ^deconnexion/?$ %{ENV:BASE}deconnexion.php [L,QSA]
RewriteRule ^commande/([0-9]+)/?$ %{ENV:BASE}detail_commande.php?cmdId=$1 [L,QSA]
RewriteRule ^checkout/([0-9]+)/?$ %{ENV:BASE}checkout.php?cmdId=$1 [L,QSA]
RewriteRule ^checkout/?$ %{ENV:BASE}checkout.php [L,QSA]
RewriteRule ^confirm/([^/]+)/?$ %{ENV:BASE}confirm.php?cmd=$1 [L,QSA]
RewriteRule ^diagnostic-securite/?$ %{ENV:BASE}diagnostic-securite.php [L,QSA]
RewriteRule ^recherche/([^/]+)/?$ %{ENV:BASE}recherche.php?search=$1 [L,QSA]
RewriteRule ^recherche/?$ %{ENV:BASE}recherche.php [L,QSA]



# Boutique/Shop - Category with subcategory and product
# Example: /boutique/category/subcategory/product/
RewriteRule ^boutique/([^/]+)/([^/]+)/([^/]+)/?$ %{ENV:BASE}produit.php?link=$3 [L,QSA]

# Boutique/Shop - Category with subcategory
# Example: /boutique/category/subcategory/
RewriteRule ^boutique/([^/]+)/([^/]+)/?$ %{ENV:BASE}categorie.php?link=$2 [L,QSA]

# Boutique/Shop - Main category
# Example: /boutique/category/
RewriteRule ^boutique/([^/]+)/?$ %{ENV:BASE}categorie.php?link=$1 [L,QSA]

# Boutique/Shop - Main page
# Example: /boutique/
RewriteRule ^boutique/?$ %{ENV:BASE}categorie.php [L,QSA]

# Applications page
# Example: /applications/
RewriteRule ^applications/?$ %{ENV:BASE}applications.php [L,QSA]

# Configurateur page
# Example: /configurateur-camera/
RewriteRule ^configurateur-camera/?$ %{ENV:BASE}configurateur-camera.php [L,QSA]

# Contact page
# Example: /contact/
RewriteRule ^contact/?$ %{ENV:BASE}contact.php [L,QSA]

# Inscription/Registration page
# Example: /inscription/
RewriteRule ^inscription/?$ %{ENV:BASE}inscription.php [L,QSA]

# Connexion/Login page
# Example: /connexion/
RewriteRule ^connexion/?$ %{ENV:BASE}connexion.php [L,QSA]

# Password forgotten page
# Example: /mdp-oublie/
RewriteRule ^mdp-oublie/?$ %{ENV:BASE}mdp-oublie.php [L,QSA]

# User account page
# Example: /compte/
RewriteRule ^compte/?$ %{ENV:BASE}compte.php [L,QSA]

# Logout page
# Example: /deconnexion/
RewriteRule ^deconnexion/?$ %{ENV:BASE}deconnexion.php [L,QSA]

# Order detail page
# Example: /commande/123/
RewriteRule ^commande/([0-9]+)/?$ %{ENV:BASE}detail_commande.php?cmdId=$1 [L,QSA]

# Express order page
# Example: /commande-express/
RewriteRule ^commande-express/?$ %{ENV:BASE}commande-express.php [L,QSA]

# Shopping cart page
# Example: /panier/
RewriteRule ^panier/?$ %{ENV:BASE}cart.php [L,QSA]

# Checkout page with optional order ID
# Example: /checkout/ or /checkout/123/
RewriteRule ^checkout/([0-9]+)/?$ %{ENV:BASE}checkout.php?cmdId=$1 [L,QSA]
RewriteRule ^checkout/?$ %{ENV:BASE}checkout.php [L,QSA]

# Order confirmation page
# Example: /confirm/ABC123/
RewriteRule ^confirm/([^/]+)/?$ %{ENV:BASE}confirm.php?cmd=$1 [L,QSA]

# Search page with optional search term
# Example: /recherche/ or /recherche/keyword/
RewriteRule ^recherche/([^/]+)/([^/]+)/?$ %{ENV:BASE}recherche.php?categorie=$1&marque=$2 [L,QSA]
RewriteRule ^recherche/([^/]+)/?$ %{ENV:BASE}recherche.php?search=$1 [L,QSA]
RewriteRule ^recherche/?$ %{ENV:BASE}recherche.php [L,QSA]

# Generic content pages
# Example: /about-us/ or any other page slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ %{ENV:BASE}contenu.php?link=$1 [L,QSA]

# ============================================
# Performance & Security Settings
# ============================================

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Disable directory browsing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8
